# ---------------------------------------------------------------------------
# Biến ỨNG DỤNG. Copy sang .env rồi điền. KHÔNG commit file .env.
#
# Biến hạ tầng (mật khẩu Postgres, cổng ra LAN) nằm ở .env tại GỐC repo.
# Docker Compose nạp tệp này vào container `api`, nhưng GHI ĐÈ `DATABASE_URL` vì
# trong mạng Docker máy chủ CSDL tên là `db`, còn giá trị dưới đây dành cho lúc
# chạy `pnpm dev:api` thẳng trên máy.
# ---------------------------------------------------------------------------

# --- Cơ sở dữ liệu ----------------------------------------------------------
# Mật khẩu phải khớp POSTGRES_PASSWORD trong .env ở gốc.
# Ký tự đặc biệt phải mã hóa URL: @ -> %40, # -> %23, / -> %2F
DATABASE_URL="postgresql://tangthu:CHANGE_ME@localhost:5432/tangthu"

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_GENERATION_MODEL="gemini-flash-latest"
# Phải khớp vector(1536) trong schema.prisma. Đổi số này mà không viết migration
# đổi kiểu cột là mọi lần ghi vector bị Postgres từ chối.
#
# Model trả 3072 chiều đã chuẩn hóa sẵn; bản cắt ngắn (1536 hay 768) thì KHÔNG,
# nên rag/embed.ts phải tự chuẩn hóa L2. Nhờ Matryoshka, gọi API một lần lấy 3072
# rồi cắt tại chỗ là có đủ cả 1536 lẫn 768 — thí nghiệm so số chiều tốn 0 lệnh gọi.
EMBEDDING_DIM="1536"

# --- Xác thực ---------------------------------------------------------------
# Chuỗi ngẫu nhiên >= 32 ký tự. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"

# --- Truy hồi ---------------------------------------------------------------
RETRIEVAL_TOP_K="10"
# Trọng số tìm kiếm lai: 1.0 là vector thuần, 0.0 là BM25 thuần.
RETRIEVAL_ALPHA="0.6"
# Dưới ngưỡng thì trả "không có trong tài liệu" thay vì đoán.
RETRIEVAL_MIN_SCORE="0.35"
CHUNK_STRATEGY="STRUCTURED"          # STRUCTURED | FIXED
CHUNK_SIZE="800"
CHUNK_OVERLAP="100"

# --- Máy chủ ----------------------------------------------------------------
PORT="4000"
NODE_ENV="development"
# Khi chạy qua Caddy thì giao diện và API cùng gốc nên CORS gần như không dùng tới.
# Giá trị dưới đây dành cho lúc chạy `pnpm dev` với web ở 3000, api ở 4000.
CORS_ORIGIN="http://localhost:3000"
MAX_UPLOAD_MB="20"
UPLOAD_DIR="./uploads"
WORKER_POLL_INTERVAL_MS="2000"

# --- Module netlab (môn Lập trình mạng) -------------------------------------
NETLAB_TCP_PORT="9999"
NETLAB_HTTP_PORT="8080"
