# ---------------------------------------------------------------------------
# Tàng Thư — biến môi trường backend
# Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.
# ---------------------------------------------------------------------------

# --- Cơ sở dữ liệu (Supabase) ----------------------------------------------
# Lấy ở Supabase: Project Settings > Database > Connection string
#
# DATABASE_URL  : transaction pooler cổng 6543, dùng lúc chạy ứng dụng.
#                 Bắt buộc có ?pgbouncer=true để Prisma tắt prepared statement.
#                 KHÔNG thêm connection_limit=1 — tham số đó dành cho môi trường
#                 serverless. Backend này là tiến trình chạy dài trên VPS nên
#                 cần một pool thật; đặt bằng 1 sẽ làm mọi request xếp hàng.
# DIRECT_URL    : session pooler cổng 5432, chỉ dùng cho prisma migrate.
#
# Mật khẩu có ký tự đặc biệt phải mã hóa URL: @ -> %40, # -> %23, / -> %2F
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage -------------------------------------------------------
# service_role key: chỉ dùng ở backend, KHÔNG bao giờ để lộ ra frontend.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documents"          # bucket phải để PRIVATE
SIGNED_URL_TTL_SECONDS="300"

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_GENERATION_MODEL="gemini-flash-latest"
EMBEDDING_DIM="1536"                 # phải khớp vector(1536) trong schema.prisma

# --- Xác thực ---------------------------------------------------------------
JWT_SECRET=""                        # chuỗi ngẫu nhiên >= 32 ký tự
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"

# --- Truy hồi ---------------------------------------------------------------
RETRIEVAL_TOP_K="8"
RETRIEVAL_MIN_SCORE="0.35"           # dưới ngưỡng thì trả "không có trong tài liệu"
CHUNK_STRATEGY="STRUCTURED"          # STRUCTURED | FIXED
CHUNK_SIZE="800"
CHUNK_OVERLAP="100"

# --- Máy chủ ----------------------------------------------------------------
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
MAX_UPLOAD_MB="20"
WORKER_POLL_INTERVAL_MS="5000"
