// ---------------------------------------------------------------------------
// Tàng Thư — Hệ thống hỏi đáp tri thức học vụ
// Nguồn duy nhất của lược đồ CSDL. Sơ đồ tương ứng: docs/erd.md
//
// CHỦ SỞ HỮU: Hồ Minh Đức (Tech Lead).
// Cần thêm bảng hoặc cột thì mở issue, không tự sửa file này — cột phạm vi
// trên bảng `chunks` quyết định toàn bộ cơ chế cách ly giữa các đơn vị.
//
// Ba thứ Prisma KHÔNG sinh được, phải viết tay trong migration:
//   1. Cột `tsv` dạng GENERATED ALWAYS
//   2. Chỉ mục HNSW và GIN
//   3. Ràng buộc CHECK cho quan hệ scope <-> department_id
// Xem hướng dẫn ở prisma/migrations-sql/01_vector_fulltext.sql
//
// GHIM PHIÊN BẢN: prisma và @prisma/client phải ở 6.16.x.
// Prisma 7.1.0 có lỗi hồi quy — `migrate dev` báo schema drift sai trên cột
// Unsupported("vector"), trong khi 6.16.3 chạy đúng. Lỗi vẫn đang mở:
// https://github.com/prisma/prisma/issues/28867
// Không nâng lên 7.x cho tới khi lỗi này đóng.
//
// KHÔNG dùng @prisma-next/extension-pgvector: gói đó thuộc bản viết lại
// Prisma Next, còn ở 0.16.0 (chưa tới 1.0), và query builder của nó che mất
// mệnh đề WHERE lọc phạm vi — thứ mà cả đồ án dựa vào. Xem ADR 001.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler cổng 6543, dùng khi ứng dụng chạy
  url       = env("DATABASE_URL")
  // Session pooler cổng 5432 — bắt buộc để chạy migrate
  directUrl = env("DIRECT_URL")
}

// KHÔNG bật preview feature `postgresqlExtensions` và KHÔNG khai báo
// `extensions = [...]`. Supabase cài sẵn pg_stat_statements, pgcrypto,
// supabase_vault, uuid-ossp và vector; khi bật cờ đó, Prisma coi chúng là
// schema drift và đòi reset toàn bộ schema `public` — tức xóa sạch dữ liệu.
// Extension `vector` đã có sẵn, kiểu vector(1536) vẫn phân giải được qua
// search_path. Câu CREATE EXTENSION nằm trong migration SQL viết tay.

// ===========================================================================
// ENUM
// ===========================================================================

enum Role {
  VIEWER
  CONTRIBUTOR
  EDITOR
  ADMIN
}

enum DepartmentType {
  KHOA
  PHONG_BAN
}

enum DocumentScope {
  GLOBAL // quy chế toàn trường, mọi đơn vị đều đọc được
  DEPARTMENT // chỉ đơn vị sở hữu đọc được
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ApprovalStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum JobType {
  PARSE
  CHUNK
  EMBED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ChunkStrategy {
  FIXED // cắt cứng theo số ký tự
  STRUCTURED // cắt theo cấu trúc Điều/Khoản
}

// ===========================================================================
// ĐƠN VỊ VÀ NGƯỜI DÙNG
// ===========================================================================

model Department {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique @db.VarChar(20) // CNTT, KT, PDT
  name      String         @db.VarChar(200)
  type      DepartmentType
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  users     User[]
  documents Document[]
  chunks    Chunk[]

  @@map("departments")
}

/// Tài khoản do ADMIN cấp — hệ thống không có chức năng tự đăng ký.
/// Một người thuộc đúng một đơn vị và giữ đúng một vai.
///
/// Đăng nhập được bằng MỘT TRONG HAI: `code` hoặc `email`, cùng mật khẩu.
/// Cả hai đều duy nhất nên không bao giờ mơ hồ.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Mã số sinh viên với VIEWER, mã cán bộ với các vai còn lại.
  /// Cho phép rỗng vì không phải ai cũng được cấp mã; Postgres cho nhiều NULL
  /// trong cột UNIQUE nên điều này không phá ràng buộc duy nhất.
  /// Chuẩn hóa CHỮ HOA trước khi ghi.
  code String? @unique @db.VarChar(20)

  /// Chuẩn hóa CHỮ THƯỜNG trước khi ghi. Có thêm chỉ mục duy nhất trên
  /// lower(email) trong migration để chặn hai tài khoản chỉ khác nhau hoa/thường.
  email        String   @unique @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(200)
  passwordHash String   @map("password_hash") @db.VarChar(255) // bcrypt
  role         Role     @default(VIEWER)
  departmentId String   @map("department_id") @db.Uuid // luôn bắt buộc
  isActive     Boolean  @default(true) @map("is_active") // false thì chặn đăng nhập
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  department        Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  conversations     Conversation[]
  uploadedDocuments Document[]     @relation("DocumentUploader")
  approvedDocuments Document[]     @relation("DocumentApprover")

  @@index([departmentId, role])
  @@map("users")
}

// ===========================================================================
// TÀI LIỆU VÀ ĐOẠN VĂN
// ===========================================================================

/// Siêu dữ liệu văn bản. File thật nằm trên Supabase Storage (bucket private),
/// bảng này chỉ giữ đường dẫn.
model Document {
  id               String           @id @default(uuid()) @db.Uuid
  title            String           @db.VarChar(500)
  docNumber        String?          @map("doc_number") @db.VarChar(100) // 1234/QĐ-ĐHKT
  issuedDate       DateTime?        @map("issued_date") @db.Date
  scope            DocumentScope
  departmentId     String?          @map("department_id") @db.Uuid // NULL khi scope = GLOBAL
  storagePath      String           @map("storage_path") @db.VarChar(500)
  mimeType         String           @map("mime_type") @db.VarChar(100)
  fileSize         Int              @map("file_size")
  pageCount        Int?             @map("page_count")
  contentHash      String           @unique @map("content_hash") @db.Char(64) // SHA-256, chặn upload trùng
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  // Mặc định PROPOSED để mặc định là đóng: EDITOR upload thì service tự
  // chuyển sang APPROVED, CONTRIBUTOR đề xuất thì giữ nguyên chờ duyệt.
  approvalStatus   ApprovalStatus   @default(PROPOSED) @map("approval_status")
  rejectReason     String?          @map("reject_reason") @db.Text
  uploadedById     String           @map("uploaded_by") @db.Uuid
  approvedById     String?          @map("approved_by") @db.Uuid
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  uploadedBy User        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvedBy User?       @relation("DocumentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  chunks     Chunk[]
  jobs       Job[]
  citations  Citation[]

  @@index([departmentId, scope, approvalStatus])
  @@index([processingStatus])
  @@map("documents")
}

/// Bảng trung tâm của truy hồi.
///
/// `departmentId` và `scope` được LẶP từ bảng documents. Đây là vi phạm chuẩn
/// hóa CÓ CHỦ ĐÍCH: chỉ mục HNSW không kết hợp tốt với JOIN lọc quyền, nếu lọc
/// sau khi lấy top-k thì kết quả có thể rỗng hoặc thiếu. Đặt cột lọc cùng bảng
/// cho phép lọc TRƯỚC khi xếp hạng. Xem ADR 002.
///
/// Cái giá: khi tài liệu đổi đơn vị hoặc đổi phạm vi, phải cập nhật đồng bộ
/// xuống toàn bộ chunks trong cùng một transaction.
model Chunk {
  id           String        @id @default(uuid()) @db.Uuid
  documentId   String        @map("document_id") @db.Uuid
  departmentId String?       @map("department_id") @db.Uuid // LẶP có chủ đích
  scope        DocumentScope // LẶP có chủ đích
  chunkIndex   Int           @map("chunk_index")
  content      String        @db.Text
  tokenCount   Int           @map("token_count")
  page         Int? // để trích dẫn mở đúng trang
  articleRef   String?       @map("article_ref") @db.VarChar(100) // "Điều 5, Khoản 2"
  contentHash  String        @map("content_hash") @db.Char(64) // khóa tra embedding_cache

  // Prisma chưa hỗ trợ hai kiểu này — mọi thao tác đọc/ghi dùng $queryRaw.
  // 1536 chiều vì HNSW của pgvector chỉ hỗ trợ tối đa 2000.
  embedding    Unsupported("vector(1536)")?
  // Cột sinh tự động: GENERATED ALWAYS AS (to_tsvector('simple', content)) STORED
  // Phải sửa tay trong file migration — xem prisma/sql/01_vector_fulltext.sql
  tsv          Unsupported("tsvector")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  citations  Citation[]

  @@unique([documentId, chunkIndex])
  @@index([scope, departmentId]) // chỉ mục quan trọng nhất của đồ án
  @@index([contentHash])
  @@map("chunks")
}

/// Cache vector theo nội dung. Nội dung không đổi thì không gọi lại API nhúng.
/// Không có khóa ngoại: cache sống độc lập với vòng đời tài liệu.
model EmbeddingCache {
  contentHash String                     @id @map("content_hash") @db.Char(64)
  model       String                     @db.VarChar(100) // gemini-embedding-001
  dim         Int // 1536
  embedding   Unsupported("vector(1536)")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("embedding_cache")
}

/// Hàng đợi xử lý tài liệu — thay cho Redis. Worker đọc bảng này theo chu kỳ.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        JobType
  documentId  String    @map("document_id") @db.Uuid
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0) // dừng sau 3 lần
  lastError   String?   @map("last_error") @db.Text
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([documentId])
  @@map("jobs")
}

// ===========================================================================
// HỘI THOẠI VÀ TRÍCH DẪN
// ===========================================================================

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(300) // sinh từ câu hỏi đầu tiên
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  latencyMs      Int?        @map("latency_ms") // đo yêu cầu phi chức năng PCN-07
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    Citation[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Nối câu trả lời về đúng đoạn văn nguồn.
///
/// `page` và `quote` được sao chép sang đây thay vì đọc qua chunk. Nhờ vậy khi
/// tài liệu bị gỡ, lịch sử hội thoại cũ vẫn hiển thị được trích dẫn — chỉ mất
/// đường dẫn mở file. Đó là lý do `chunkId` và `documentId` cho phép NULL.
model Citation {
  id         String  @id @default(uuid()) @db.Uuid
  messageId  String  @map("message_id") @db.Uuid
  chunkId    String? @map("chunk_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid
  page       Int?
  quote      String  @db.Text
  rank       Int // thứ hạng trong kết quả truy hồi
  score      Float

  message  Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk    Chunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([messageId, rank])
  @@map("citations")
}

// ===========================================================================
// BỘ ĐÁNH GIÁ
// ===========================================================================

/// Mỗi dòng là một lần chạy bộ câu hỏi vàng với một cấu hình cắt đoạn.
/// Tiêu chí thành công số 4: bảng này phải có ít nhất 3 dòng để so sánh.
model EvalRun {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200) // "structured-800-overlap-100"
  chunkStrategy ChunkStrategy @map("chunk_strategy")
  chunkSize     Int           @map("chunk_size")
  chunkOverlap  Int           @map("chunk_overlap")
  topK          Int           @map("top_k")
  embeddingDim  Int           @map("embedding_dim")
  totalQuestion Int           @map("total_question")
  recallAt5     Float?        @map("recall_at_5")
  recallAt10    Float?        @map("recall_at_10")
  mrr           Float?
  note          String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  results EvalResult[]

  @@map("eval_runs")
}

model EvalResult {
  id                 String  @id @default(uuid()) @db.Uuid
  evalRunId          String  @map("eval_run_id") @db.Uuid
  questionCode       String  @map("question_code") @db.VarChar(50) // mã trong golden-questions.yaml
  expectedDocumentId String? @map("expected_document_id") @db.Uuid
  hit                Boolean
  rankOfFirstHit     Int?    @map("rank_of_first_hit") // NULL nếu trượt

  evalRun EvalRun @relation(fields: [evalRunId], references: [id], onDelete: Cascade)

  @@unique([evalRunId, questionCode])
  @@map("eval_results")
}
