# ---------------------------------------------------------------------------
# TỆP CẤU HÌNH DUY NHẤT của dự án.
#
# Docker Compose đọc để nội suy biến và nạp vào container `api`; các script
# chạy trên máy (db:seed, db:embed, prisma) cũng đọc chính tệp này.
#
# KHÔNG commit. Xem docs/khoi-tao.md.
# ---------------------------------------------------------------------------
# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=tangthu
POSTGRES_DB=tangthu
# Bắt buộc, KỂ CẢ Ở CHẾ ĐỘ CLOUD: Compose nội suy toàn bộ tệp bất kể hồ sơ nào
# đang bật, nên thiếu biến này là không chạy được gì. Chế độ cloud không dùng tới
# giá trị, điền gì cũng được. Sinh chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# --- Chế độ CSDL ------------------------------------------------------------
# Để nguyên `local`: Postgres chạy trong Docker, đúng thiết kế demo LAN.
#
# Dùng Postgres trên cloud (Supabase, Neon…): xóa dòng COMPOSE_PROFILES rồi bỏ
# chú thích DATABASE_URL. Dịch vụ `db` sẽ không khởi động.
#   - Bắt buộc có `connect_timeout`, nếu không Prisma báo nhầm lỗi xác thực
#     thành "Can't reach database server" và che mất nguyên nhân thật.
#   - Ký tự đặc biệt trong mật khẩu phải mã hóa URL: @ -> %40, # -> %23
COMPOSE_PROFILES=local
# DATABASE_URL=postgresql://NGUOI_DUNG:MAT_KHAU@HOST:5432/postgres?connect_timeout=30&sslmode=require

# --- Cổng ra LAN ------------------------------------------------------------
# Đây là cổng DUY NHẤT mở ra mạng lớp. Đổi sang 8000 nếu cổng 80 đã bị chiếm.
HTTP_PORT=80

# --- CORS -------------------------------------------------------------------
# Trình duyệt gọi API qua Caddy ở cùng gốc nên hiếm khi cần sửa. Chỉ đổi nếu chạy
# giao diện tách khỏi Caddy. Nhiều origin thì ngăn cách bằng dấu phẩy.
CORS_ORIGIN=http://localhost

# --- Cơ sở dữ liệu ----------------------------------------------------------
# Mật khẩu phải khớp POSTGRES_PASSWORD trong .env ở gốc.
# Ký tự đặc biệt phải mã hóa URL: @ -> %40, # -> %23, / -> %2F
DATABASE_URL="postgresql://tangthu:CHANGE_ME@localhost:5432/tangthu"

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_GENERATION_MODEL="gemini-flash-latest"
# Tran token cho cau tra loi. Model co buoc suy nghi noi bo va nhung token do cung
# tinh vao tran, nen de rong.
GENERATION_MAX_TOKENS="2048"
# Phải khớp vector(1536) trong schema.prisma. Đổi số này mà không viết migration
# đổi kiểu cột là mọi lần ghi vector bị Postgres từ chối.
#
# Model trả 3072 chiều. Bản `gemini-embedding-2` chuẩn hóa sẵn cả khi cắt ngắn
# (L2 = 1.0000), nhưng bản `-001` thì KHÔNG (1536 chiều cho L2 = 0.694) — vì vậy
# rag/embed.ts vẫn tự chuẩn hóa L2 cho cả hai. Phép chuẩn hóa lại một vector đã
# chuẩn là vô hại, nên bỏ bước đó đi chỉ để tiết kiệm vài phép chia là đặt bẫy
# cho ai đổi model về sau.
EMBEDDING_DIM="1536"
# Mã hóa câu hỏi khác cách mã hóa tài liệu. Là BIẾN CỦA BỘ ĐÁNH GIÁ, chưa chốt:
# phép thử một mẫu cho thấy nó không cải thiện. Đo ở Sprint 4 rồi hãy quyết.
GEMINI_USE_TASK_TYPE="true"

# --- Xác thực ---------------------------------------------------------------
# Chuỗi ngẫu nhiên >= 32 ký tự. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"

# --- Truy hồi ---------------------------------------------------------------
RETRIEVAL_TOP_K="10"
# Trọng số tìm kiếm lai: 1.0 là vector thuần, 0.0 là BM25 thuần.
RETRIEVAL_ALPHA="0.6"
# Dưới ngưỡng thì trả "không có trong tài liệu" thay vì đoán.
RETRIEVAL_MIN_SCORE="0.35"
CHUNK_STRATEGY="STRUCTURED"          # STRUCTURED | FIXED
CHUNK_SIZE="800"
CHUNK_OVERLAP="100"

# --- Máy chủ ----------------------------------------------------------------
PORT="4000"
NODE_ENV="development"
# Khi chạy qua Caddy thì giao diện và API cùng gốc nên CORS gần như không dùng tới.
# Giá trị dưới đây dành cho lúc chạy `pnpm dev` với web ở 3000, api ở 4000.
MAX_UPLOAD_MB="20"
UPLOAD_DIR="./uploads"
WORKER_POLL_INTERVAL_MS="2000"

# --- Module netlab (môn Lập trình mạng) -------------------------------------
NETLAB_TCP_PORT="9999"
NETLAB_HTTP_PORT="8080"
